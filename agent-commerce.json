{
 "$schema": "https://raw.githubusercontent.com/krisdiallo/ecom-agent/main/agent-commerce.schema.json",
 "name": "agent-commerce-index",
 "version": "1.0.0",
 "measured": "2026-08-28",
 "license": "MIT",
 "homepage": "https://github.com/krisdiallo/ecom-agent",
 "about": "Which consumer storefronts expose a live agent-commerce endpoint an AI agent can call to search a catalogue, build a cart and complete a checkout \u2014 bypassing HTML entirely. Measured by probing each host, not read from documentation. Probe was read-only: it called only tools/list, which enumerates capabilities, and never created a cart or started a checkout.",
 "method": {
  "discovery": "GET /.well-known/ucp for a merchant profile, falling back to /api/ucp/mcp",
  "probe": "POST JSON-RPC {\"method\":\"tools/list\"} to the advertised MCP endpoint",
  "counted_live": "endpoint returned a parseable tool list",
  "sample": "Convenience sample of well-known consumer brands, fixed before any results were seen. Biased toward well-resourced stores; not a random sample.",
  "scanner": "research/ucp_scan.py"
 },
 "summary": {
  "hosts_probed": 70,
  "live_endpoints": 49,
  "ucp_versions": [
   "2026-04-08"
  ],
  "distinct_tool_surfaces": 1,
  "uniform_tool_surface": true
 },
 "finding": "All 49 live endpoints exposed an identical 13-tool surface on a single UCP version. There was no variation at all. Agent-commerce capability is therefore currently a property of the PLATFORM, not a merchant configuration choice \u2014 a store has it because its platform enabled it, not because anyone opted in. Two consequences: a merchant cannot meaningfully 'optimise' this axis today beyond choosing a platform, and an agent developer can assume a uniform tool surface across these stores rather than negotiating per-merchant capabilities.",
 "tool_surface": [
  "cancel_cart",
  "cancel_checkout",
  "complete_checkout",
  "create_cart",
  "create_checkout",
  "get_cart",
  "get_checkout",
  "get_order",
  "get_product",
  "lookup_catalog",
  "search_catalog",
  "update_cart",
  "update_checkout"
 ],
 "purchase_capable_tools": [
  "cancel_cart",
  "cancel_checkout",
  "complete_checkout",
  "create_cart",
  "create_checkout",
  "get_cart",
  "get_checkout",
  "get_order",
  "update_cart",
  "update_checkout"
 ],
